{
  "name": "mauritania-mobility-intelligence-node",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "generate:governance": "node scripts/generate-canonical-data.mjs",
    "validate:governance": "node scripts/generate-canonical-data.mjs --check",
    "type-check": "npm run generate:governance && tsc --noEmit",
    "build": "npm run generate:governance && tsc && vite build",
    "lint": "npm run validate:governance && tsc --noEmit",
    "test": "npm run generate:governance && vitest run",
    "test:smoke": "vitest run tests/route-smoke.test.ts",
    "test:i18n": "vitest run tests/multilingual.test.ts tests/rtl.test.ts",
    "test:evidence": "vitest run tests/evidence-schema.test.ts tests/publication-gate.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.4"
  }
}
